generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum ChatRole {
  user
  assistant
  system
}

enum SourceType {
  profile
  skill
  experience
  project
  project_image
  resume
}

model Profile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  headline    String
  summary     String
  location    String?
  phone       String?
  email       String?
  githubUrl   String?  @map("github_url")
  linkedinUrl String?  @map("linkedin_url")
  jobdbUrl    String?  @map("jobdb_url")
  avatarUrl   String?  @map("avatar_url")
  avatarPath  String?  @map("avatar_path")
  avatarAlt   String?  @map("avatar_alt")
  resumeUrl   String?  @map("resume_url")
  resumePath  String?  @map("resume_path")
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Skill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  category    String
  priority    Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, priority])
  @@map("skills")
}

model Experience {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company     String
  role        String
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  periodLabel String?  @map("period_label")
  summary     String?
  highlights  Json     @default("[]")
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder])
  @@map("experiences")
}

model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  summary     String
  problem     String?
  solution    String?
  role        String?
  stack       Json     @default("[]")
  architecture String?
  deployment  String?
  impact      String?
  githubUrl   String?  @map("github_url")
  demoUrl     String?  @map("demo_url")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  sortOrder   Int      @default(0) @map("sort_order")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  images ProjectImage[]
  tags   ProjectTag[]

  @@index([isPublished, isFeatured, sortOrder])
  @@map("projects")
}

model ProjectTag {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  tag       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tag])
  @@index([tag])
  @@map("project_tags")
}

model ProjectImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  imageUrl  String @map("image_url")
  imagePath String? @map("image_path")
  alt       String
  isCover   Boolean @default(false) @map("is_cover")
  sortOrder Int @default(0) @map("sort_order")
  isPublished Boolean @default(false) @map("is_published")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isCover, sortOrder])
  @@map("project_images")
}

model ChatSession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionKey  String   @unique @map("session_key")
  locale      String   @default("en")
  summary     String?
  activeTopic String?  @map("active_topic")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  role          ChatRole
  content       String
  provider      String?
  model         String?
  tokenEstimate Int?     @map("token_estimate")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model AiProviderSetting {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerName String  @unique @map("provider_name")
  isEnabled    Boolean @default(true) @map("is_enabled")
  priority     Int     @default(0)
  timeoutMs    Int     @default(10000) @map("timeout_ms")
  modelName    String  @map("model_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isEnabled, priority])
  @@map("ai_provider_settings")
}

model PortfolioChunk {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType  SourceType @map("source_type")
  sourceId    String?    @map("source_id") @db.Uuid
  locale      String     @default("en")
  title       String
  content     String
  tags        Json       @default("[]")
  priority    Int        @default(0)
  isPublic    Boolean    @default(false) @map("is_public")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sourceType, sourceId])
  @@index([locale, isPublic, priority])
  @@map("portfolio_chunks")
}

model RateLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipAddress String   @map("ip_address")
  actionKey String   @map("action_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipAddress, actionKey, createdAt], map: "rate_limits_ip_action_created_idx")
  @@map("rate_limits")
}
